# Publieke URL van de app (bijv. https://werkplank.uwloge.nl)
PUBLIC_APP_URL=http://localhost:3000

# Pad naar het SQLite databasebestand (standaard ./data/werkplanken.sqlite)
DATABASE_PATH=./data/werkplanken.sqlite

# Zet op 'false' zodra de app live staat voor echte leden!
# (Dan verdwijnen het Proef-postvak en de test-snelkoppelingen)
ENABLE_DEV_MAILBOX=true

# Zet op 'true' wanneer de app achter HTTPS draait in productie
HTTPS=false

# E-mail verzending (SMTP) voor inlogcodes en werkplank-uitnodigingen
# Werkt met elke Europese mailprovider (TransIP, Hostnet, Proton, Microsoft 365, etc.)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Mijn Werkplank Secretariaat <secretaris@uwloge.nl>"
